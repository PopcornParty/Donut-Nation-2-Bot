# Required
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here

# Strongly recommended so slash commands show up instantly
GUILD_ID=your_guild_id_here

# Optional persistent database path on Railway
DATABASE_PATH=/data/donut.db

TZ=Europe/London
LOG_LEVEL=info

# Your Discord user ID. Highest bot access, above owner and admin.
# Right-click your name in Discord -> Copy User ID
DEV_USER_IDS=your_discord_user_id_here
