# ============================================================
# Donut Nation 2 Bot — Environment Variables
# Copy this file to .env for local development.
# On Railway, add these in Variables (do NOT commit real values).
# ============================================================

# Required. Bot token from Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Required. Application ID from Discord Developer Portal → General Information
CLIENT_ID=your_application_id_here

# Strongly recommended. Your Discord server (guild) ID.
# When set, slash commands register instantly to this guild.
# Right-click the server icon → Copy Server ID (Developer Mode on).
GUILD_ID=your_guild_id_here

# Optional. SQLite file path. Use a persistent volume on Railway.
# Example Railway volume mount: /data  →  DATABASE_PATH=/data/donut.db
DATABASE_PATH=./data/donut.db

# Optional. IANA timezone used for daily giveaways and timestamps.
# Examples: America/New_York, Europe/London, UTC
TZ=America/New_York

# Optional. Log verbosity: debug | info | warn | error
LOG_LEVEL=info
